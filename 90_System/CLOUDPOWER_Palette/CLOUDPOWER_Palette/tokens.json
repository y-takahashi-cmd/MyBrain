{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "CLOUDPOWER Palette",
  "version": "2.0.0",
  "description": "Cloud Power Inc. Official Color System — Primary #74B2E0",
  "brand": {
    "blue": "#74B2E0",
    "gray": "#9E9E9F"
  },
  "colors": {
    "primary": {
      "50":  "#F2F8FC",
      "100": "#D6E9F5",
      "200": "#C5DDE9",
      "300": "#A3CDE8",
      "400": "#74B2E0",
      "500": "#5A9BC7",
      "600": "#4A8CC4",
      "700": "#2E6BA6",
      "800": "#245180",
      "900": "#1A3A5C"
    },
    "gray": {
      "50":  "#F8F8F8",
      "100": "#F0F0F0",
      "200": "#E0E0E0",
      "300": "#CCCCCC",
      "400": "#AAAAAA",
      "500": "#888888",
      "600": "#666666",
      "700": "#4A4A4A",
      "800": "#333333",
      "900": "#1A1A1A"
    },
    "success": {
      "50":  "#E6F5EB",
      "300": "#7DD39B",
      "500": "#28A745",
      "700": "#1B7D3A"
    },
    "warning": {
      "50":  "#FFF8E1",
      "300": "#FFD666",
      "500": "#F0AD00",
      "700": "#C68A00"
    },
    "error": {
      "50":  "#FDEAEA",
      "300": "#F09DA5",
      "500": "#DC3545",
      "700": "#B71C1C"
    },
    "info": {
      "50":  "#F2F8FC",
      "300": "#A3CDE8",
      "500": "#74B2E0",
      "700": "#2E6BA6"
    },
    "chart": {
      "1": { "name": "CP Blue",    "value": "#74B2E0", "pptxRole": "accent1" },
      "2": { "name": "Deep Blue",  "value": "#2E6BA6", "pptxRole": "hlink" },
      "3": { "name": "Teal",       "value": "#5BBFB5", "pptxRole": "accent4" },
      "4": { "name": "Amber",      "value": "#F0AD00", "pptxRole": "accent6" },
      "5": { "name": "Sand",       "value": "#D4885C", "pptxRole": "accent2" },
      "6": { "name": "Steel",      "value": "#6B8FA3", "pptxRole": "accent5" },
      "7": { "name": "Forest",     "value": "#3D8B4A", "pptxRole": "accent3" },
      "8": { "name": "Slate",      "value": "#7A98AE", "pptxRole": "folHlink" }
    }
  },
  "semantic": {
    "light": {
      "page-bg":        "#F2F8FC",
      "card-bg":        "#FFFFFF",
      "heading":        "#1A3A5C",
      "body":           "#4A4A4A",
      "sub":            "#666666",
      "header-bg":      "#74B2E0",
      "header-gradient": "linear-gradient(135deg, #2E6BA6 0%, #74B2E0 100%)"
    },
    "dark": {
      "page-bg":        "#0F1B2A",
      "card-bg":        "#1A2940",
      "heading":        "#A3CDE8",
      "body":           "#CCDDEE",
      "sub":            "#8899AA",
      "header-bg":      "#1A3A5C",
      "header-gradient": "linear-gradient(135deg, #1A3A5C 0%, #2E6BA6 100%)"
    }
  },
  "aliases": {
    "primary":       "{colors.primary.400}",
    "text-default":  "{colors.gray.700}",
    "text-heading":  "{colors.primary.900}",
    "link":          "{colors.primary.700}",
    "border":        "{colors.gray.200}"
  }
